{
  "type": "object",
  "properties": {
    "shot_date_key": {
      "type": "string",
      "description": "Dedup instance key. For shot-based reminders: YYYY-MM-DD of the scheduled shot. For refill: 'inventory:{id}'. For weekly: 'week:{YYYY-Www}'. For check-in/weigh-in/re-engagement: YYYY-MM-DD of the run date."
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "due_today",
        "overdue",
        "upcoming",
        "confirmation",
        "missed_dose",
        "refill_low",
        "weekly_summary",
        "side_effect_checkin",
        "weigh_in",
        "reengagement"
      ],
      "default": "due_today",
      "description": "Type of reminder sent"
    },
    "medication": {
      "type": "string",
      "description": "Medication name the reminder was about (if applicable)"
    }
  },
  "required": [
    "shot_date_key",
    "reminder_type"
  ],
  "name": "ReminderLog",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}