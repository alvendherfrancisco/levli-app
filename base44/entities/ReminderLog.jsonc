{
  "type": "object",
  "properties": {
    "shot_date_key": {
      "type": "string",
      "description": "YYYY-MM-DD of the scheduled shot date this reminder was for"
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "due_today",
        "overdue",
        "upcoming"
      ],
      "default": "due_today",
      "description": "Type of reminder sent"
    },
    "medication": {
      "type": "string",
      "description": "Medication name the reminder was about"
    }
  },
  "required": [
    "shot_date_key",
    "reminder_type"
  ],
  "name": "ReminderLog",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}