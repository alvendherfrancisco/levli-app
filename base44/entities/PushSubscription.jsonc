{
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "description": "Push subscription endpoint URL from the browser PushManager"
    },
    "keys_p256dh": {
      "type": "string",
      "description": "P-256 ECDH public key from the subscription (base64url)"
    },
    "keys_auth": {
      "type": "string",
      "description": "Auth secret from the subscription (base64url)"
    }
  },
  "required": [
    "endpoint",
    "keys_p256dh",
    "keys_auth"
  ],
  "name": "PushSubscription",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}