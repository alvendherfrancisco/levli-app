{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_shot_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-shot-reminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send shot reminders",
            "description": "Checks each user's shot schedule and sends a push reminder on the morning of their scheduled shot day"
          }
        }
      }
    ]
  },
  "name": "Daily Shot Reminder",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 7-21 * * *",
      "one_time_date": null,
      "timezone": "Asia/Manila",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Checks every 30 minutes (7am-10pm Manila) for shots due today and sends a push reminder to users with notifications enabled"
}