{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_shot_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-daily-reminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily reminders",
            "description": "Push notification to all subscribers"
          }
        }
      }
    ]
  },
  "name": "Daily Shot Reminder",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Manila",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends a daily push notification reminder to all subscribed users at 8 AM Manila time"
}